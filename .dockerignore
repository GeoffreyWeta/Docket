# Keep the build context small and the image clean.
.git
.gitignore
.gitattributes
.venv
**/__pycache__
**/*.pyc
frontend/node_modules
frontend/dist
backend/staticfiles
backend/db.sqlite3
docs
README.md
render.yaml
build.sh

# The vendor register: real bank details, TINs, emails and phone numbers for
# about 1,400 companies. It reaches a deployment through VENDORS_URL at start,
# never through the image — an image layer is as permanent as a git commit.
backend/data/vendors*.json
.env
