__pycache__/
*.pyc
backend/db.sqlite3
backend/staticfiles/
frontend/node_modules/
frontend/dist/
.env
.venv/

# The vendor master export. Real company bank details, TINs and contacts:
# the importer reads it locally, the database keeps a masked copy, and it
# never belongs in version control.
backend/data/vendors*.json

# Per-deployment settings: SECRET_KEY (which is the bid encryption key),
# DATABASE_URL, SMTP credentials. The .example files are the ones that travel.
deploy/*.env

# Throwaway design-preview harness: mounts the landing page once per design.
# Its own header says it is deleted after the screenshots, so it is not a
# build input and should not arrive in a clone.
__harness.*
