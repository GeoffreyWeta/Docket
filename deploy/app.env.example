# The REAL workspace. Copy to deploy/app.env and fill in. Never commit the copy.
#
#   cp deploy/app.env.example deploy/app.env
#   ./deploy/lightsail.sh deploy/app.env --create

SERVICE_NAME=docket-app
AWS_REGION=eu-west-1
POWER=nano
SCALE=1

# ---------------------------------------------------------------------------
# SECRET_KEY IS THE ENCRYPTION KEY.
#
# Bid amounts, line prices and uploaded documents are encrypted at rest with a
# Fernet key derived from it (backend/core/util.py). Generate it ONCE:
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Then keep it somewhere you cannot lose it. Change it on a deployment holding
# sealed bids and every one of them becomes permanently unreadable — there is no
# recovery, by design.
# ---------------------------------------------------------------------------
SECRET_KEY=

# A container service has no durable disk. Without this, Django falls back to
# SQLite inside the container and every tender, bid and uploaded document is
# destroyed on the next deploy. Point it at a Lightsail managed database or RDS:
#   postgres://USER:PASSWORD@HOST:5432/docket
DATABASE_URL=

# The public address. Decides the HTTPS redirect, secure cookies, CSRF origins
# and — the one people forget — the links in password-reset, team-invite and
# vendor-claim emails, which are sent with no request to build a URL from.
# On the first deploy you do not know the Lightsail URL yet: deploy, read it off
# the output, set it here, deploy again. Or put your own domain in front.
PUBLIC_BASE_URL=https://app.example.com

# ---- this is the real workspace, so: no demo ----
# One-click sign-in as any seeded persona. Off here, always.
DEMO_LOGIN=0
# Start empty. The first person through the door gets the setup wizard and
# becomes the owner; anyone after that arrives by invitation.
SEED_DEMO=0

# ---- optional ----
# Private, time-limited link to the vendor register JSON. Fetched at container
# start, imported, gone when the container dies. The register never goes in git
# or in the image: real bank details, TINs and contacts for ~1,400 companies.
VENDORS_URL=

# Powers the six AI features. Without it they return "not configured" and
# everything else works.
ANTHROPIC_API_KEY=

# SMTP. Without it every email prints to the container log instead of being
# sent — which on the real deployment means invitations silently go nowhere.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=DOCKET <no-reply@example.com>

WEB_CONCURRENCY=2
LOG_LEVEL=INFO
