# The DEMO workspace. Copy to deploy/demo.env and fill in. Never commit the copy.
#
#   cp deploy/demo.env.example deploy/demo.env
#   ./deploy/lightsail.sh deploy/demo.env --create
#
# This is a SEPARATE service with a SEPARATE database from the real workspace.
# DOCKET is single-tenant: one org row, no tenant key on tenders or suppliers.
# Sharing a database would mean a company that ran setup here renamed the demo
# org and inherited its tenders. See deploy/README.md.

SERVICE_NAME=docket-demo
AWS_REGION=eu-west-1
POWER=nano
SCALE=1

# Still the encryption key — but these are demo bids, so losing it costs
# nothing. Generate one anyway; the default is "dev-only-insecure-key".
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# The demo can be rebuilt from seed at any time, so a small database is fine —
# but it still must not be SQLite-in-a-container, or every walkthrough resets
# itself on redeploy and anyone mid-demo watches their tender vanish.
DATABASE_URL=

PUBLIC_BASE_URL=https://demo.example.com

# ---- this is the demo, so: demo ----
# Exposes the one-click personas. The sign-in screen keeps them behind /demo
# rather than on the front page, so the address can be handed out without the
# first thing a stranger sees being a way in.
DEMO_LOGIN=1
# The password seeded on every demo account. Generate one; do not leave it at
# the "docket-demo" default on anything reachable from the internet.
DEMO_PASSWORD=
# Fill the workspace with the seeded tenders, personas and suppliers. The
# command is a no-op when data already exists, so this is safe on every deploy.
SEED_DEMO=1

# The setup wizard stays reachable on the demo (DEMO_LOGIN keeps it open), so
# it still wants a code - and it must not be the real deployment's one. Running
# the wizard here renames the demo org, which is annoying rather than serious;
# using the real code to discover that is neither.
SETUP_CODE=DEMOSETUP

# ---- optional ----
ANTHROPIC_API_KEY=

# Leave SMTP unset and emails print to the container log, which is usually what
# you want for a demo — nobody gets mail they did not ask for.
DEFAULT_FROM_EMAIL=DOCKET demo <no-reply@example.com>

WEB_CONCURRENCY=1
LOG_LEVEL=INFO
